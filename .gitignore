# The submission rules forbid shipping datasets or index files.
data/*.hdf5
data/cache/
*.index
*.faiss
*.bin

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# Results are regenerated by run_all.sh, but results.csv and the figures ARE
# part of the deliverable, so they are tracked. Scratch output is not.
results/scratch/
results/*.tmp
# --quick output is scratch, never a deliverable
results/quick/

.DS_Store

# run logs and scratch archives
*.log
results_full.zip
